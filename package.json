{
  "name": "cyber-hengdian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open virtual production infrastructure for humans and AI agents",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check": "npm run format:check && tsx tools/schemas.ts --check && python3 scripts/check_template.py --project && npm test && npm run build",
    "cli": "tsx tools/cli.ts",
    "mcp": "tsx tools/mcp.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tools/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tools/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"*.config.ts\"",
    "schema": "tsx tools/schemas.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "3.2.7"
  }
}
